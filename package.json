{
  "name": "amap-vue-kit",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "license": "MIT",
  "homepage": "https://github.com/Notryag/amap-vue-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Notryag/amap-vue-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Notryag/amap-vue-kit/issues"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* run build",
    "build:all": "pnpm run build && pnpm --filter ./docs run build && pnpm --filter ./examples/basic run build",
    "dev:docs": "pnpm --filter ./docs run dev",
    "dev:playground": "pnpm --filter @amap-vue/playground run dev",
    "dev:example": "pnpm --filter ./examples/basic run dev",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "typecheck": "vue-tsc --build --force",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:npm-names": "node scripts/check-npm-names.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install",
    "release": "pnpm run release:stable",
    "release:stable": "pnpm run lint && pnpm run typecheck && pnpm exec vitest run && pnpm run build:all && pnpm run verify:pack && changeset publish",
    "release:canary": "pnpm changeset version --snapshot canary && pnpm install && pnpm -r publish --tag canary --access public --no-git-checks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.7.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.37.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.1"
  }
}
